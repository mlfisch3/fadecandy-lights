{
  "effects": [
    {
      "name": "breathe",
      "display_name": "Breathe",
      "description": "A colour pulsing smoothly between two brightness levels.",
      "params": [
        {
          "name": "color",
          "type": "color",
          "default": {
            "mode": "kelvin",
            "kelvin": 2700.0,
            "rgb": [
              255,
              173,
              89
            ]
          },
          "label": "Colour",
          "description": "",
