          "kelvin_range": [
            1800.0,
            6500.0
          ],
          "kelvin_default": 2700.0
        },
        {
          "name": "speed",
          "type": "float",
          "default": 0.25,
          "label": "Speed",
          "description": "Cycles per second. 0 freezes the animation.",
