          "maximum": 3.0,
          "step": 0.01,
          "unit": "Hz"
        },
        {
          "name": "minimum",
          "type": "float",
          "default": 0.05,
          "label": "Dimmest",
          "description": "Brightness at the bottom of the breath.",
          "minimum": 0.0,
          "maximum": 1.0,
          "step": 0.01
        },
        {
          "name": "maximum",
          "type": "float",
          "default": 1.0,
          "label": "Brightest",
          "description": "Brightness at the top of the breath.",
          "minimum": 0.0,
          "maximum": 1.0,
          "step": 0.01
        }
      ]
    },
